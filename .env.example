# ==============================================================================
# Kestrel Agency OS — Environment Configuration
# Copy to .env for local runs. NEVER commit real secrets to source control.
# ==============================================================================

# Free local AI — install Ollama and pull the model documented in docs/OPERATIONS.md.
# Defaults work on the same machine; set these only when Ollama runs elsewhere.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3.5:4b"
OLLAMA_GENERATION_TIMEOUT_SECONDS="900"

# Optional cloud AI provider (separate free-tier key and quotas may apply)
GEMINI_API_KEY=""

# Optional Paid / Secondary AI Providers (leave unset if not configured)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
RUNWAY_API_KEY=""

# Public application URL (required for OAuth callback URLs)
APP_URL="http://localhost:3000"

# Security & Cryptographic Signing (required in production; each value must be a random secret of 32+ characters)
SESSION_SECRET=""
STORAGE_SIGNING_SECRET=""
CREDENTIAL_ENCRYPTION_KEY=""

# Database and file storage paths (use mounted persistent volumes in production; do not use ephemeral container disk)
SQLITE_DB_PATH="./data/kestrel-agency.sqlite"
STORAGE_ROOT_DIR="./data/storage"

# Neon PostgreSQL (Vercel Preview API; local core API still uses SQLite)
# Keep the preview-only connection string out of git. Never put a production URL in this file.
DATABASE_URL=""
MORGAN_NEON_WORKER_ENABLED="false"

# Separate, isolated Neon database for the local content worker.
# Store only the `morgan_pipeline_review` branch connection string in .env.worker.local.
MORGAN_WORKER_DATABASE_URL=""

# Supabase Project Integration (Add in AI Studio Settings > Secrets to connect your Supabase account)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="agency-assets"

# Social Media Platform OAuth Integrations (Optional — shown as Not Configured until provided)
# Callback URL format: ${APP_URL}/api/oauth/<platform>/callback
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Worker Engine Tuning
WORKER_POLL_INTERVAL_MS="2000"
WORKER_LEASE_SECONDS="60"
